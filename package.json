{
	"name": "icloud-mcp",
	"version": "0.1.0",
	"description": "MCP server for iCloud Mail over IMAP and SMTP: search, read, file, draft, send",
	"license": "MIT",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"lint": "oxlint --fix --report-unused-disable-directives && oxfmt",
		"check": "oxlint --deny-warnings --report-unused-disable-directives && oxfmt --check && tsc && bun test"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "^2.3.1",
		"@types/bun": "^1.4.3",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^7.0.2"
	}
}
